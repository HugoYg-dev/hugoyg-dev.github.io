# 博客园 MetaWeblog API 配置
# 请在博客园后台：设置 -> 博客设置 -> 申请/配置 MetaWeblog 访问令牌
# 获取后将此文件复制为 .env 并填入实际配置

# 博客空间标识（通常为您的博客后缀名，例如 https://www.cnblogs.com/hugoyang 中的 hugoyang）
CNBLOGS_BLOG_ID=

# 博客园登录用户名
CNBLOGS_USERNAME=

# 博客园 MetaWeblog 访问令牌 / API Key（注意：不是登录密码，是 MetaWeblog 专用 Token）
CNBLOGS_API_KEY=

# 可选：自定义 RPC 接口地址（默认为 https://rpc.cnblogs.com/metaweblog/${CNBLOGS_BLOG_ID}）
# CNBLOGS_ENDPOINT=https://rpc.cnblogs.com/metaweblog/hugoyang
