---
import { analyticsConfig } from "@/config";

const { enable, provider, goatcounterSite, umamiScriptSrc, umamiWebsiteId } = analyticsConfig;

const showGoatcounter = enable && provider === "goatcounter" && !!goatcounterSite;
const showUmami = enable && provider === "umami" && !!umamiScriptSrc && !!umamiWebsiteId;
---

{showGoatcounter && (
	<script is:inline async data-goatcounter={goatcounterSite} src="https://gc.zgo.at/count.js"></script>
)}

{showUmami && (
	<script is:inline defer src={umamiScriptSrc} data-website-id={umamiWebsiteId}></script>
)}
